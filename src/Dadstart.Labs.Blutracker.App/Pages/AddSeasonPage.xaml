<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Dadstart.Labs.Blutracker.Pages.AddSeasonPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add season">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label FontSize="18" Text="Season details" />

        <Entry Keyboard="Numeric" Placeholder="Season number" Text="{Binding SeasonNumber}" />
        <Entry Keyboard="Numeric" Placeholder="Episode count (optional)" Text="{Binding EpisodeCount}" />

        <HorizontalStackLayout Spacing="12">
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
            <Button Text="Save" Command="{Binding SaveCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>

